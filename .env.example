# Optional. Without it the globe uses Esri World Imagery as the base map and terrain mode is disabled.
# Get a free token at https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=

# Optional. Without these, projects / requests / audit logs are stored in this browser only (labelled LOCAL).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER put the Supabase secret key or any provider API secret in a VITE_ variable —
# everything prefixed VITE_ is shipped to the browser.

# Optional, server-side only (Vercel → Settings → Environment Variables). Do NOT prefix with VITE_.
# N2YO is the primary source for single-satellite elements and pass predictions; without it the
# app uses CelesTrak elements + local SGP4. Get a free key at https://www.n2yo.com/login/ (Profile → API).
N2YO_API_KEY=
